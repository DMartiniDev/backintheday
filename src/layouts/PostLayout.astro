---
import BaseLayout from './BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TOC from '../components/TOC.astro';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { SITE_NAME, AUTHOR_NAME, GITHUB_REPO } from '../config/site';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, date, categories, excerpt, github } = post.data;

const slug = post.slug;
const canonicalUrl = `${import.meta.env.SITE}/posts/${slug}`;
const ogImageUrl = post.data.ogImage
  ? new URL(post.data.ogImage, Astro.url).href
  : `${import.meta.env.SITE}/og/${slug}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: excerpt,
  author: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: import.meta.env.SITE,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: import.meta.env.SITE,
  },
  datePublished: date.toISOString(),
  image: ogImageUrl,
  url: canonicalUrl,
};

const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
});

const githubUrl = `https://github.com/${GITHUB_REPO}/edit/main/${github ?? `src/content/posts/${post.slug}.md`}`;

// Estimate read time from raw markdown body
const wordCount = post.body.trim().split(/\s+/).length;
const readTime = `${Math.max(1, Math.round(wordCount / 200))} min read`;

const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={`${title} — ${SITE_NAME}`}
  description={excerpt}
  ogType="article"
  ogImage={ogImageUrl}
  canonicalUrl={canonicalUrl}
  publishedDate={date}
  articleTags={categories}
  jsonLd={jsonLd}
>
  <div class="reading-progress" id="reading-progress"></div>

  <main class="page-wrap" id="page-main">
    <div class="post-meta">
      <span class="meta-date">{dateStr}</span>
      <span class="meta-sep">·</span>
      <span class="meta-readtime">{readTime}</span>
      <span class="meta-sep">·</span>
      {categories.map(cat => (
        <a href={`/?category=${encodeURIComponent(cat)}`} class="tag">{cat}</a>
      ))}
    </div>

    <h1 class="post-title">{title}</h1>

    {filteredHeadings.length >= 2 && <TOC headings={filteredHeadings} />}

    <article class="prose" id="prose-content">
      <slot />
    </article>

    <AuthorCard />

    <!-- Giscus comments (lazy-loaded) -->
    <div class="giscus-wrapper">
      <h2 class="giscus-heading">Comments</h2>
      <div id="giscus-container" tabindex="-1"></div>
    </div>

    <div class="post-actions">
      <div class="share-group">
        <span class="share-label">Share</span>
        <button class="share-btn" id="share-x">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L2.25 2.25H8.08l4.261 5.635 5.903-5.635Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X / Twitter
        </button>
        <button class="share-btn" id="share-linkedin">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </button>
        <button class="share-btn" id="share-copy">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 9.5a3.5 3.5 0 0 0 5 0l2-2a3.5 3.5 0 0 0-5-5l-1 1"/><path d="M9.5 6.5a3.5 3.5 0 0 0-5 0l-2 2a3.5 3.5 0 0 0 5 5l1-1"/></svg>
          Copy link
        </button>
      </div>
      <a href={githubUrl} class="github-link" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        Suggest changes on GitHub
      </a>
    </div>
  </main>

  <script>
    // Giscus lazy-load: trigger on scroll-into-view (IntersectionObserver) or keyboard focus
    // Phase 2: update GISCUS_REPO_ID and GISCUS_CAT_ID in src/config/site.ts after GitHub repo rename
    import { GISCUS_REPO, GISCUS_REPO_ID, GISCUS_CAT, GISCUS_CAT_ID } from '../config/site';

    function getTheme(): string {
      const t = document.documentElement.getAttribute('data-theme');
      if (t === 'dark') return 'dark';
      if (t === 'light') return 'light';
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function loadGiscus(): void {
      const container = document.getElementById('giscus-container');
      if (!container || container.hasAttribute('data-loaded')) return;
      container.setAttribute('data-loaded', '');

      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo',              GISCUS_REPO);
      script.setAttribute('data-repo-id',           GISCUS_REPO_ID);
      script.setAttribute('data-category',          GISCUS_CAT);
      script.setAttribute('data-category-id',       GISCUS_CAT_ID);
      script.setAttribute('data-mapping',           'pathname');
      script.setAttribute('data-strict',            '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata',     '0');
      script.setAttribute('data-input-position',    'top');
      script.setAttribute('data-theme',             getTheme());
      script.setAttribute('data-lang',              'en');
      script.crossOrigin = 'anonymous';
      script.async = true;
      container.appendChild(script);
    }

    function initGiscus(): void {
      const giscusContainer = document.getElementById('giscus-container');
      if (!giscusContainer) return;

      const observer = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            loadGiscus();
            observer.disconnect();
          }
        },
        { rootMargin: '200px' }
      );
      observer.observe(giscusContainer);
      giscusContainer.addEventListener('focus', () => loadGiscus(), { once: true });
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    }

    initGiscus();
    document.addEventListener('astro:after-swap', initGiscus);
  </script>

  <button
    id="back-to-top"
    class="back-to-top"
    aria-label="Back to top"
  >↑</button>

  <script>
    let btAbort: AbortController | null = null;
    // Back to top button
    function initBackToTop(): void {
      btAbort?.abort();
      const btController = new AbortController();
      btAbort = btController;

      const btn = document.getElementById('back-to-top') as HTMLButtonElement;
      if (!btn) return;

      const THRESHOLD = window.innerHeight;
      let prevScrollY = 0;
      let hideTimer: ReturnType<typeof setTimeout> | null = null;

      btController.signal.addEventListener('abort', () => {
        if (hideTimer !== null) { clearTimeout(hideTimer); hideTimer = null; }
      });

      function show(): void {
        clearTimeout(hideTimer);
        btn.classList.add('visible');
        hideTimer = setTimeout(() => { if (btn.isConnected) hide(); }, 3000);
      }

      function hide(): void {
        btn.classList.remove('visible');
        hideTimer = null;
      }

      const s = { signal: btController.signal };

      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        const scrollingDown = y > prevScrollY;
        prevScrollY = y;
        if (scrollingDown && y > THRESHOLD) {
          show();
        } else if (!scrollingDown) {
          hide();
        }
      }, { passive: true, signal: btController.signal });

      btn.addEventListener('mouseenter', () => clearTimeout(hideTimer), s);
      btn.addEventListener('mouseleave', () => {
        if (btn.classList.contains('visible')) {
          hideTimer = setTimeout(() => { if (btn.isConnected) hide(); }, 3000);
        }
      }, s);
      btn.addEventListener('focus', () => clearTimeout(hideTimer), s);
      btn.addEventListener('blur', () => {
        if (btn.classList.contains('visible')) {
          hideTimer = setTimeout(() => { if (btn.isConnected) hide(); }, 3000);
        }
      }, s);
      btn.addEventListener('click', () => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
        hide();
      }, s);
    }

    initBackToTop();
    document.addEventListener('astro:after-swap', initBackToTop);
  </script>

  <script>
    let rpAbort: AbortController | null = null;
    // Image skeleton: remove loading class once each image resolves
    function initImageSkeletons() {
      document.querySelectorAll('.image-wrapper').forEach(wrapper => {
        const img = wrapper.querySelector('img');
        if (!img) return;
          const settle = () => wrapper.classList.remove('image-loading');
          const fail   = () => { wrapper.classList.add('image-error'); settle(); };
          if (img.complete) {
            // complete=true covers both loaded and failed; naturalWidth distinguishes them
            img.naturalWidth > 0 ? settle() : fail();
          } else {
            img.addEventListener('load',  settle, { once: true });
            img.addEventListener('error', fail,   { once: true });
          }
      });
    }

    // Reading progress bar
    function initReadingProgress(): void {
      const bar  = document.getElementById('reading-progress') as HTMLElement;
      const main = document.getElementById('page-main') as HTMLElement;
      if (!bar || !main) return;

      rpAbort?.abort();
      const rpController = new AbortController();
      rpAbort = rpController;

      const total = main.offsetHeight - window.innerHeight;
      let rafPending = false;

      window.addEventListener('scroll', () => {
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(() => {
          rafPending = false;
          const pct = total > 0
            ? Math.min(100, Math.max(0, (window.scrollY / total) * 100))
            : 100;
          bar.style.width = pct + '%';
        });
      }, { passive: true, signal: rpController.signal });
    }

    // Code block copy buttons
    function initCopyButtons(): void {
      document.querySelectorAll('.prose pre').forEach(pre => {
        if (pre.querySelector('.code-header')) return;

        const code = pre.querySelector('code');
        if (!code) return;

        const cls = code.className || '';
        const langMatch = cls.match(/language-(\w+)/);
        const lang = langMatch ? langMatch[1] : '';

        const header = document.createElement('div');
        header.className = 'code-header';

        const label = document.createElement('span');
        const title = (pre as HTMLElement).dataset.title;
        if (title) {
          label.className = 'code-title';
          label.textContent = title;
        } else {
          label.className = 'code-lang';
          label.textContent = lang;
        }
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'Copy';
        header.appendChild(label);
        header.appendChild(btn);
        pre.insertBefore(header, pre.firstChild);

        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(code.textContent ?? '').then(() => {
            btn.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
          }).catch(() => {});
        });
      });
    }

    // Heading anchor links
    function initHeadingAnchors(): void {
      document.querySelectorAll('.prose h2, .prose h3, .prose h4').forEach(heading => {
        if (!heading.id || heading.querySelector('.heading-anchor')) return;
        const anchor = document.createElement('a');
        anchor.href = `#${heading.id}`;
        anchor.className = 'heading-anchor';
        anchor.textContent = '#';
        anchor.setAttribute('aria-hidden', 'true');
        anchor.setAttribute('tabindex', '-1');
        heading.appendChild(anchor);
      });
    }

    // Share buttons — capture URL/title fresh on each call so VT navigation uses the correct post
    function initShareButtons(): void {
      const pageUrl   = window.location.href;
      const pageTitle = encodeURIComponent(document.title);

      document.getElementById('share-x')?.addEventListener('click', () => {
        window.open(`https://twitter.com/intent/tweet?text=${pageTitle}&url=${encodeURIComponent(pageUrl)}`, '_blank', 'width=600,height=400');
      });

      document.getElementById('share-linkedin')?.addEventListener('click', () => {
        window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`, '_blank', 'width=600,height=500');
      });

      const copyBtn = document.getElementById('share-copy') as HTMLButtonElement;
      if (!copyBtn) return;
      const originalHTML = copyBtn.innerHTML;
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(pageUrl).then(() => {
          copyBtn.textContent = '✓ Copied!';
          copyBtn.classList.add('copied');
          setTimeout(() => {
            copyBtn.innerHTML = originalHTML;
            copyBtn.classList.remove('copied');
          }, 2500);
        }).catch(() => {});
      });
    }

    initImageSkeletons();
    initReadingProgress();
    initCopyButtons();
    initHeadingAnchors();
    initShareButtons();

    document.addEventListener('astro:after-swap', () => {
      initImageSkeletons();
      initReadingProgress();
      initCopyButtons();
      initHeadingAnchors();
      initShareButtons();
    });
  </script>
</BaseLayout>
